<Window x:Class="PokerNoteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poker Notes"
        Icon="Assets/app_icon.png"
        Height="760" Width="1150" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#E2E8F0"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#111827" />
        <SolidColorBrush x:Key="PanelBg2" Color="#0F172A" />
        <SolidColorBrush x:Key="Line" Color="#1F2937" />
        <SolidColorBrush x:Key="Line2" Color="#334155" />
        <SolidColorBrush x:Key="TextDim" Color="#94A3B8" />

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#334155" CornerRadius="5" Margin="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#273449" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#7F1D1D" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="Foreground" Value="#FEE2E2" />
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Foreground" Value="#CBD5E1" />
        </Style>

        <Style x:Key="WinBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- Text helpers -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="CaretBrush" Value="#60A5FA" />
            <Setter Property="SelectionBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tag chip (list item in the player list) -->
        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#172033" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E3A8A" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox (screen picker) -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D4ED8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                                  Fill="#94A3B8" Data="M 0 0 L 4 4 L 8 0 Z" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              Margin="10,0,26,0" VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0" Background="#0E1526" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="♠   POKER NOTES" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="─" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="▢" ToolTip="Maximize" Click="Maximize_Click" />
                    <Button x:Name="BtnClose" Style="{StaticResource WinBtn}" Content="✕" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="1" Background="#0E1526" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Margin="12,9">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" Style="{StaticResource Input}"
                         ToolTip="Search name, alias or note text (Ctrl+F)" TextChanged="SearchBox_TextChanged" />
                <Button x:Name="BtnNew" Style="{StaticResource BtnAccent}" Content="＋  New player" Margin="0,0,8,0"
                        ToolTip="Create a new player (Ctrl+N)" Click="NewPlayer_Click" />
                <Button x:Name="BtnTags" Style="{StaticResource Btn}" Content="🏷  Tags" Margin="0,0,8,0"
                        ToolTip="Manage tags and colours" Click="Tags_Click" />
                <Button x:Name="BtnOpenDb" Style="{StaticResource Btn}" Content="📂  Open DB" Margin="0,0,8,0"
                        ToolTip="Switch to another notes file" Click="OpenDb_Click" />
                <Button x:Name="BtnExport" Style="{StaticResource Btn}" Content="⬇  Export CSV" Margin="0,0,8,0"
                        ToolTip="Export every player with notes and tags to CSV" Click="ExportCsv_Click" />
                <Button x:Name="BtnHelp" Style="{StaticResource Btn}" Content="?" Width="32" ToolTip="Shortcuts" Click="Help_Click" />
            </DockPanel>

            <!-- scan bar: buttons wrap on narrow windows, pickers and status on their own rows,
                 so no button can ever be squeezed invisible -->
            <StackPanel Margin="0,9,0,0">
                <WrapPanel x:Name="ScanButtonPanel">
                    <Button x:Name="BtnScan" Style="{StaticResource BtnAccent}" Content="📸  Capture &amp; Scan" Margin="0,0,8,8"
                            ToolTip="Read the player names on the tables and show hover boxes (middle mouse also works)"
                            Click="CaptureScan_Click" />
                    <Button x:Name="BtnPasteScan" Style="{StaticResource Btn}" Content="📋  Paste &amp; Scan" Margin="0,0,8,8"
                            ToolTip="Scan a screenshot that is on the clipboard" Click="PasteScan_Click" />
                    <Button x:Name="BtnSnip" Style="{StaticResource Btn}" Content="✂️  Snip Player" Margin="0,0,8,8"
                            ToolTip="Drag a box over the player's name on the table: the name is read from the marked area and the player is opened (an unknown name opens the create dialog with the reading filled in). A plain click reads the name plate under the cursor"
                            Click="Snip_Click" />
                    <Button x:Name="BtnBoxHere" Style="{StaticResource Btn}" Content="📌  Box here" Margin="0,0,8,8"
                            ToolTip="Put a hover box for the player selected in the list where the mouse was last on a table. Ctrl + middle mouse button does the same right on the table"
                            Click="AddBoxHere_Click" />
                    <Button x:Name="BtnBoxes" Style="{StaticResource Btn}" Content="👁  Boxes: ON" Margin="0,0,8,8"
                            ToolTip="Show or hide the hover boxes" Click="ToggleBoxes_Click" />
                    <Button x:Name="BtnOnlyDb" Style="{StaticResource Btn}" Content="🗂  DB only: OFF" Margin="0,0,8,8"
                            ToolTip="Only show boxes for players that are already in the database"
                            Click="ToggleOnlyDb_Click" />
                    <Button x:Name="BtnClearBoxes" Style="{StaticResource Btn}" Content="🧹  Clear" Margin="0,0,8,8"
                            ToolTip="Remove every hover box (and forget the boxes you removed with Ctrl+click)"
                            Click="ClearBoxes_Click" />
                    <Button x:Name="BtnDebugShot" Style="{StaticResource Btn}" Content="🔎  Snapshot" Margin="0,0,8,8"
                            ToolTip="Save the captured screens with the boxes and readings drawn on them"
                            Click="DebugSnapshot_Click" />
                </WrapPanel>
                <DockPanel LastChildFill="False" Margin="0,2,0,0">
                    <ComboBox x:Name="AutoScanPicker" DockPanel.Dock="Right" Width="120" Style="{StaticResource DarkCombo}"
                              Margin="8,0,0,0" ToolTip="Scan the tables again on a timer, so the boxes follow players who come and go"
                              SelectionChanged="AutoScanPicker_SelectionChanged" />
                    <TextBlock DockPanel.Dock="Right" Text="AUTO" Foreground="#64748B" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ScreenPicker" DockPanel.Dock="Right" Width="210" Style="{StaticResource DarkCombo}"
                              Margin="12,0,0,0" ToolTip="Which screen to look at" SelectionChanged="ScreenPicker_SelectionChanged" />
                    <TextBlock DockPanel.Dock="Right" Text="SCREEN" Foreground="#64748B" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>
                <TextBlock x:Name="ScanStatus" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="No scan yet. Press Capture &amp; Scan (or the middle mouse button) while your tables are open." />
            </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="230" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Player list -->
            <Border Grid.Column="0" Background="#0F1626" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <Button x:Name="BtnAddToTable" DockPanel.Dock="Right" Style="{StaticResource BtnAccent}"
                                Content="➕  Add to table" Padding="9,3,9,3" FontSize="11" Margin="8,0,0,0"
                                ToolTip="Put a hover box for the player selected below where the mouse was last on a table (Ctrl + middle mouse button on the name does the same). Nothing on the table yet? The marking layer opens, so you can drag where the name is"
                                Click="AddToTable_Click" />
                        <TextBlock x:Name="ListCount" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="PLAYERS" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="TagFilterPanel" Margin="12,0,12,8" />
                    </ScrollViewer>
                    <ListBox x:Name="PlayerList" Background="Transparent" BorderThickness="0" Margin="6,0,6,8"
                             ItemContainerStyle="{StaticResource ListRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="PlayerList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TagSummary}" Foreground="#93C5FD"
                                                   FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Preview}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#0B1020" ResizeBehavior="PreviousAndNext" />

            <!-- Editor -->
            <Grid Grid.Column="2" Background="#0B1020">
                <TextBlock x:Name="EmptyHint" Text="Select a player on the left, or press Ctrl+N to create one."
                           Foreground="#475569" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- The editor scrolls when the window is short (small screens / low resolution), so the
                     note field and the save buttons can always be reached. -->
                <ScrollViewer x:Name="EditorBody" Visibility="Collapsed" Padding="20,16,20,16"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- name -->
                    <DockPanel Grid.Row="0">
                        <TextBlock x:Name="PlayerNameText" DockPanel.Dock="Left" FontSize="21" FontWeight="Bold" Foreground="#F8FAFC"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="SavedText" Foreground="#4ADE80" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button x:Name="BtnRename" Style="{StaticResource Btn}" Content="✎ Rename" Margin="0,0,6,0" Click="Rename_Click" />
                            <Button x:Name="BtnHistory" Style="{StaticResource Btn}" Content="🕘 History" Margin="0,0,6,0" Click="History_Click" />
                            <Button x:Name="BtnDelete" Style="{StaticResource BtnDanger}" Content="🗑 Delete" Click="DeletePlayer_Click" />
                        </StackPanel>
                    </DockPanel>

                    <!-- aliases -->
                    <DockPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="ALIASES" Style="{StaticResource Label}" Width="74" Margin="0,8,0,0" />
                        <TextBox x:Name="AliasBox" Style="{StaticResource Input}"
                                 ToolTip="Other nick names for the same player, comma separated"
                                 TextChanged="AliasBox_TextChanged" />
                    </DockPanel>

                    <!-- tags -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="TAGS" Style="{StaticResource Label}" />
                        <WrapPanel x:Name="PlayerTagPanel" />
                        <WrapPanel x:Name="TagPickPanel" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- notes -->
                    <DockPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="NOTES" Style="{StaticResource Label}" />
                        <TextBox x:Name="NotesBox" Style="{StaticResource NotesInput}" MinHeight="110"
                                 VerticalScrollBarVisibility="Auto" TextChanged="NotesBox_TextChanged" />
                    </DockPanel>

                    <!-- footer -->
                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="NotesInfo" DockPanel.Dock="Left" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSnapshot" Style="{StaticResource Btn}" Content="💾 Save note copy" Margin="0,0,6,0"
                                    ToolTip="Store the current note in this player's history" Click="Snapshot_Click" />
                            <Button x:Name="BtnSaveNow" Style="{StaticResource BtnAccent}" Content="✔ Save now (Ctrl+S)" Click="SaveNow_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="3" Background="#0E1526" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="False">
                <TextBlock x:Name="StatusDb" DockPanel.Dock="Left" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusCount" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ============ Overlays (children of the root grid: no extra windows, no focus stealing) ============ -->
        <Grid x:Name="TagsOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="40" Background="#CC050A14" Visibility="Collapsed">
        <Border Background="#111827" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10"
                Width="580" MaxHeight="560" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="✕" Width="32" Click="CloseOverlays_Click" ToolTip="Close (Esc)" />
                    <TextBlock Text="🏷  TAGS" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnAccent}" Content="＋ Add" Margin="8,0,0,0" Click="TagAdd_Click" />
                    <TextBox x:Name="NewTagColor" DockPanel.Dock="Right" Width="86" Margin="8,0,0,0" Style="{StaticResource Input}" Text="#FF8C00" />
                    <TextBox x:Name="NewTagName" Style="{StaticResource Input}" ToolTip="Tag name - press Enter to add" KeyDown="NewTagName_KeyDown" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Close" Width="90" Click="CloseOverlays_Click" />
                    <TextBlock Text="Deleting a tag removes it from every player." Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TagManageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Delete" Padding="8,3" FontSize="11" Click="TagDelete_Click" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ColorHex}" Foreground="#94A3B8" FontSize="11"
                                                   VerticalAlignment="Center" Margin="10,0,10,0" />
                                        <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

    <Grid x:Name="HistoryOverlay" Grid.RowSpan="4" Panel.ZIndex="41" Background="#CC050A14" Visibility="Collapsed">
        <Border Background="#111827" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10"
                Width="620" MaxHeight="560" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="✕" Width="32" Click="CloseOverlays_Click" ToolTip="Close (Esc)" />
                    <TextBlock x:Name="HistoryTitle" Text="🕘  NOTE HISTORY" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="↩ Load into editor" Click="HistoryLoad_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Close" Width="90" Click="CloseOverlays_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Clear history" Margin="0,0,8,0" Click="HistoryClear_Click" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding When}" Foreground="#93C5FD" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

        <Grid x:Name="ScanResultOverlay" Grid.RowSpan="4" Panel.ZIndex="44" Background="#CC050A14" Visibility="Collapsed">
            <Border Background="#111827" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10"
                    Width="620" MaxHeight="560" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="✕" Width="32" Click="CloseOverlays_Click" />
                        <TextBlock x:Name="ScanResultTitle" Text="SCAN RESULT" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ScanResultHint" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,10" Text="Click a name to open the player. Names with ? are not in the database yet." />
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn}" Content="Close" Width="90"
                            HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseOverlays_Click" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <WrapPanel x:Name="ScanNamePanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="PromptOverlay" Grid.RowSpan="4" Panel.ZIndex="42" Background="#CC050A14" Visibility="Collapsed">
            <Border Background="#111827" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10"
                    Width="460" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="PromptTitle" Text="Name" Foreground="#F1F5F9" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBox x:Name="PromptInput" Style="{StaticResource Input}" KeyDown="PromptInput_KeyDown" />
                    <TextBlock x:Name="PromptHint" Foreground="#64748B" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource Btn}" Content="Cancel" Width="90" Margin="0,0,8,0" Click="CloseOverlays_Click" />
                        <Button Style="{StaticResource BtnAccent}" Content="OK" Width="90" Click="PromptOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="HelpOverlay" Grid.RowSpan="4" Panel.ZIndex="43" Background="#CC050A14" Visibility="Collapsed">
            <Border Background="#111827" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10"
                    Width="480" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Poker Notes - shortcuts" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Foreground="#CBD5E1" FontSize="12" LineHeight="22">
                        Ctrl+N   new player<LineBreak />
                        Ctrl+F   jump to search<LineBreak />
                        Ctrl+S   save now<LineBreak />
                        F2       rename selected player<LineBreak />
                        Ctrl+E   save a copy of the note in history<LineBreak />
                        Esc      close dialog / clear search<LineBreak />
                        <LineBreak />
                        On the tables:<LineBreak />
                        middle mouse   capture the tables and read the names<LineBreak />
                        middle drag    move the box under the mouse where you want it<LineBreak />
                        Ctrl+middle    put a box for the player selected in the list, right there<LineBreak />
                        hover a box    show the player's tags and notes<LineBreak />
                        click a box    write a note (tags included) right there<LineBreak />
                        Ctrl+click     remove that single box<LineBreak />
                        right-click    not used (it folds on Unibet)<LineBreak />
                        <LineBreak />
                        ✂ Snip Player    drag a box over the name and it is read from that area<LineBreak />
                        (a plain click reads the name plate under the cursor)<LineBreak />
                        <LineBreak />
                        Found a player in the search? Pick it in the list and press<LineBreak />
                        "Add to table" - the box is put where the mouse last was on a table,<LineBreak />
                        or you drag where the name is when the table is not seen yet.<LineBreak />
                        <LineBreak />
                        Boxes are green when the player is known; tagged players get their tag colour<LineBreak />
                        and the tag names next to the box. "DB only" hides everyone else.<LineBreak />
                        The AUTO picker rescans on a timer, so the boxes follow players who come and go.<LineBreak />
                        A box placed by hand (Ctrl+middle, or "Box here") stays until 🧹 Clear or a restart,<LineBreak />
                        which is the way to box a player whose name the OCR reads wrong or not at all.<LineBreak />
                        A scan reads every name plate on its own as well (that takes a moment longer and is<LineBreak />
                        noticeably more accurate), and it keeps the boxes when a table could not be read.<LineBreak />
                        <LineBreak />
                        Notes save themselves while you type (about a second after you stop).<LineBreak />
                        Aliases let you find a player under other nick names too.<LineBreak />
                        The database is a plain .json file - back it up like any other file.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource Btn}" Content="Open log" Margin="0,0,8,0" Click="OpenLog_Click" />
                        <Button Style="{StaticResource BtnAccent}" Content="Got it" Width="100" Click="CloseOverlays_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
